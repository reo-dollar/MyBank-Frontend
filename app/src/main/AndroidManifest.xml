<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ====================================================== -->
    <!-- Permissions -->
    <!-- ====================================================== -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- ====================================================== -->
    <!-- Application -->
    <!-- ====================================================== -->

    <application
        android:name=".MyBankApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyBank"
        android:usesCleartextTraffic="true">

        <!-- ================================================== -->
        <!-- Splash -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.splash.SplashActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- ================================================== -->
        <!-- Authentication -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.admin.AdminCustomerManagementActivity"
            android:exported="false" />

        <activity
            android:name=".activities.admin.AdminCustomerDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.admin.AdminUserManagementActivity"
            android:exported="false" />

        <activity
            android:name=".activities.admin.AdminAccountTransactionActivity"
            android:exported="false" />

        <activity
            android:name=".activities.admin.AdminAccountManagementActivity"
            android:exported="false" />

        <activity
            android:name=".activities.admin.AdminAccountDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.AdminTransactionsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".activities.auth.AuthenticationActivity"
            android:exported="false" />

        <activity
            android:name=".activities.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Reset Password Deep Link -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.auth.ResetPasswordActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="mybank"
                    android:host="reset-password" />

            </intent-filter>

        </activity>

        <!-- ================================================== -->
        <!-- Dashboard -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- KYC -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.kyc.PersonalDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.kyc.ContactDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.kyc.GovernmentIdActivity"
            android:exported="false" />

        <activity
            android:name=".activities.kyc.AddressActivity"
            android:exported="false" />

        <activity
            android:name=".activities.kyc.EmploymentActivity"
            android:exported="false" />

        <activity
            android:name=".activities.kyc.ReviewActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Banking -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.banking.CreateAccountActivity"
            android:exported="false" />

        <activity
            android:name=".activities.banking.DepositActivity"
            android:exported="false" />

        <activity
            android:name=".activities.banking.WithdrawActivity"
            android:exported="false" />

        <activity
            android:name=".activities.banking.TransferActivity"
            android:exported="false" />

        <activity
            android:name=".activities.banking.TransactionHistoryActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Profile -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".activities.profile.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".activities.profile.ChangePasswordActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Payments -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.payments.PaymentsActivity"
            android:parentActivityName=".activities.dashboard.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.MobileRechargeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.ElectricityBillActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.WaterBillActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.GasBillActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.DthRechargeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.BroadbandRechargeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.FastagRechargeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.InsurancePaymentActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.FixedDepositActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- QR -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.qr.QRScannerActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Transaction PIN -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.pin.SetTransactionPinActivity"
            android:exported="false" />

        <activity
            android:name=".activities.pin.VerifyTransactionPinActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Recurring Deposit -->
        <!-- ================================================== -->

        <activity
            android:name=".activities.payments.recurringdeposit.RDDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.RDCalculatorActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.OpenRDActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.RDListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.RDDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.PayRDInstallmentActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.RDHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.MaturedRDActivity"
            android:exported="false" />

        <activity
            android:name=".activities.payments.recurringdeposit.PrematureCloseRDActivity"
            android:exported="false" />

        <!-- ================================================== -->
        <!-- Main Activity -->
        <!-- ================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">


        <!-- ========================================================= -->
        <!-- PROGRESS                                                   -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- STEP 1 - COMPLETED -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_completed"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR 1 -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"

                android:background="@color/primary" />


            <!-- STEP 2 - COMPLETED -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_completed"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR 2 -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"

                android:background="@color/primary" />


            <!-- STEP 3 - COMPLETED -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_completed"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR 3 -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"

                android:background="@color/primary" />


            <!-- STEP 4 - COMPLETED -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_completed"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR 4 -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"

                android:background="@color/primary" />


            <!-- STEP 5 - ACTIVE -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"

                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_active"
                android:backgroundTint="@color/primary" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- STEP INDICATOR                                              -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:text="Step 5 of 5"

            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- TITLE                                                       -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Employment Details"

            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- SUBTITLE                                                    -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Tell us about your employment and account"

            android:textColor="@color/text_secondary"
            android:textSize="14sp" />


        <!-- ========================================================= -->
        <!-- OCCUPATION LABEL                                            -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:text="Occupation"

            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- OCCUPATION                                                  -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:layout_marginTop="8dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <Spinner
                android:id="@+id/spOccupation"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:entries="@array/occupation_array"

                android:paddingStart="16dp"
                android:paddingEnd="12dp"

                android:spinnerMode="dropdown"

                android:textColor="@color/text_primary" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- ACCOUNT TYPE LABEL                                          -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:text="Account Type"

            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- ACCOUNT TYPE                                                -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:layout_marginTop="8dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <Spinner
                android:id="@+id/spAccountType"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:entries="@array/account_type_array"

                android:paddingStart="16dp"
                android:paddingEnd="12dp"

                android:spinnerMode="dropdown"

                android:textColor="@color/text_primary" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- PASSWORD                                                    -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Password"

            app:endIconMode="password_toggle"

            app:boxBackgroundColor="@color/surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:boxStrokeColor="?attr/colorOutline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"

            app:hintTextColor="@color/text_secondary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:inputType="textPassword"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"

                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- CONFIRM PASSWORD                                            -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:hint="Confirm Password"

            app:endIconMode="password_toggle"

            app:boxBackgroundColor="@color/surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:boxStrokeColor="?attr/colorOutline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"

            app:hintTextColor="@color/text_secondary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:inputType="textPassword"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"

                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- REVIEW BUTTON                                               -->
        <!-- ========================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReview"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="24dp"

            android:text="Review  →"
            android:textAllCaps="false"

            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"

            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:elevation="3dp" />

    </LinearLayout>

</ScrollView>
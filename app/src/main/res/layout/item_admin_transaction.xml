<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"

    app:cardBackgroundColor="@color/admin_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/admin_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">


        <!-- ================================================= -->
        <!-- TOP ROW -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- TRANSACTION TYPE -->

            <TextView
                android:id="@+id/tvTransactionType"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:ellipsize="end"
                android:maxLines="1"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"

                tools:text="TRANSFER" />


            <!-- TRANSACTION AMOUNT -->

            <TextView
                android:id="@+id/tvTransactionAmount"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"

                android:textColor="@color/admin_error"
                android:textSize="17sp"
                android:textStyle="bold"

                tools:text="- ₹5,000.00" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TRANSACTION ID -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTransactionId"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:textColor="@color/admin_text_secondary"
            android:textSize="13sp"

            tools:text="Transaction ID: #123" />


        <!-- ================================================= -->
        <!-- FROM -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvFromAccount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:textColor="@color/admin_primary"
            android:textSize="14sp"

            tools:text="From: 202600000001" />


        <!-- ================================================= -->
        <!-- TO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvToAccount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:textColor="@color/admin_primary"
            android:textSize="14sp"

            tools:text="To: 202600000002" />


        <!-- ================================================= -->
        <!-- REMARKS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvRemarks"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:textColor="@color/admin_text_secondary"
            android:textSize="13sp"

            tools:text="Mobile Recharge - Airtel" />


        <!-- ================================================= -->
        <!-- TIMESTAMP -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTimestamp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:textColor="@color/admin_text_muted"
            android:textSize="12sp"

            tools:text="14 Aug 2026, 08:30 PM" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:paddingTop="52dp">

        <!-- ========================= -->
        <!-- Header -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏦 Fixed Deposit"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculate your Fixed Deposit maturity instantly"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- ========================= -->
        <!-- Deposit Amount -->
        <!-- ========================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPrincipal"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:hint="Deposit Amount"

            app:prefixText="₹ ">

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/etPrincipal"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="numberDecimal"

                android:maxLines="1"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- Interest Rate -->
        <!-- ========================= -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/layoutInterest"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Interest Rate (%)"

            app:suffixText="%">

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/etInterest"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="numberDecimal"

                android:maxLines="1"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- Tenure -->
        <!-- ========================= -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/layoutTenure"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Tenure"

            app:suffixText="Years">

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/etTenure"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="numberDecimal"

                android:maxLines="1"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- Tenure Type -->
        <!-- ========================= -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/layoutTenureType"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Tenure Type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView

                android:id="@+id/actTenureType"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="none"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- Interest Type -->
        <!-- ========================= -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/layoutInterestType"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Interest Type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView

                android:id="@+id/actInterestType"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="none"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- Compounding Frequency -->
        <!-- ========================= -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/layoutCompounding"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Compounding Frequency">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView

                android:id="@+id/actCompounding"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="none"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========================= -->
        <!-- Investment Summary -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Investment Summary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E0E0E0"/>

                <!-- Principal -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="Principal"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvPrincipal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="₹0"/>

                </LinearLayout>

                <!-- Interest -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="Interest Earned"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvInterest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="₹0"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Maturity -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="Maturity Amount"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvMaturity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="₹0"
                        android:textColor="#1565C0"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Tenure -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="Tenure"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTenure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="-"/>

                </LinearLayout>

                <!-- Interest Rate -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="Interest Rate"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="-"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- Buttons -->
        <!-- ========================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CALCULATE"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:text="RESET"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
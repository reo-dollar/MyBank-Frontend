<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="#F5F9FF">


    <!-- ===================================================== -->
    <!-- APP BAR                                                -->
    <!-- ===================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:paddingStart="8dp"
        android:paddingEnd="16dp"

        android:background="#1565C0">


        <ImageButton

            android:id="@+id/btnBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Back"

            android:padding="12dp"

            android:src="@drawable/ic_arrow_back"

            app:tint="@android:color/white" />


        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="Review Payment"

            android:textColor="@android:color/white"

            android:textSize="20sp"

            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT                                                -->
    <!-- ===================================================== -->

    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">


            <!-- ================================================= -->
            <!-- TITLE                                               -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:gravity="center"

                android:text="Review your payment"

                android:textColor="#102A43"

                android:textSize="22sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"

                android:gravity="center"

                android:text="Please check the details before continuing."

                android:textColor="#607D8B"

                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- RECIPIENT CARD                                      -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="18dp"

                android:background="@drawable/bg_qr_recipient_card">


                <TextView

                    android:id="@+id/tvRecipientInitials"

                    android:layout_width="58dp"
                    android:layout_height="58dp"

                    android:gravity="center"

                    android:text="RV"

                    android:textColor="#1565C0"

                    android:textSize="19sp"

                    android:textStyle="bold"

                    android:background="@drawable/bg_qr_recipient_avatar" />


                <LinearLayout

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="16dp"

                    android:orientation="vertical">


                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Paying to"

                        android:textColor="#78909C"

                        android:textSize="12sp" />


                    <TextView

                        android:id="@+id/tvRecipientName"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="Recipient Name"

                        android:textColor="#102A43"

                        android:textSize="17sp"

                        android:textStyle="bold" />


                    <TextView

                        android:id="@+id/tvMaskedAccount"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="XXXXXXXX0003"

                        android:textColor="#607D8B"

                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- AMOUNT CARD                                         -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="vertical"

                android:gravity="center"

                android:padding="24dp"

                android:background="@drawable/bg_qr_recipient_card">


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Amount to pay"

                    android:textColor="#607D8B"

                    android:textSize="13sp" />


                <TextView

                    android:id="@+id/tvAmount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:gravity="center"

                    android:text="₹500.00"

                    android:textColor="#1565C0"

                    android:textSize="38sp"

                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PAYMENT ID                                          -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="vertical"

                android:padding="16dp"

                android:background="@drawable/bg_qr_payment_id">


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Payment ID"

                    android:textColor="#607D8B"

                    android:textSize="12sp" />


                <TextView

                    android:id="@+id/tvPaymentId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:text="PAY_..."

                    android:textColor="#1565C0"

                    android:textSize="12sp"

                    android:textStyle="bold"

                    android:breakStrategy="balanced" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SECURITY INFORMATION                                -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="vertical"

                android:padding="16dp"

                android:background="@drawable/bg_qr_info">


                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Security check"

                    android:textColor="#8A5A00"

                    android:textSize="14sp"

                    android:textStyle="bold" />


                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:text="Make sure the recipient and amount are correct. Your payment will require transaction PIN verification."

                    android:textColor="#795548"

                    android:textSize="13sp" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- CONTINUE BUTTON                                         -->
    <!-- ===================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:padding="16dp"

        android:background="@android:color/white">


        <Button

            android:id="@+id/btnContinue"

            android:layout_width="match_parent"
            android:layout_height="54dp"

            android:backgroundTint="#1565C0"

            android:text="Continue"

            android:textAllCaps="false"

            android:textColor="@android:color/white"

            android:textSize="16sp"

            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center_vertical">


            <!-- BACK -->

            <TextView
                android:id="@+id/btnBack"

                android:layout_width="46dp"
                android:layout_height="46dp"

                android:gravity="center"

                android:text="‹"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="normal"
                android:fontFamily="sans"
                android:includeFontPadding="false"

                android:clickable="true"
                android:focusable="true"

                android:contentDescription="Back"

                android:background="?attr/selectableItemBackgroundBorderless" />


            <!-- HEADER TITLE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"
                android:gravity="center"

                android:layout_marginEnd="46dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Review Details"

                    android:textColor="@color/text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold"

                    android:fontFamily="sans"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- SUBTITLE                                              -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Please review your information before submitting"

            android:textColor="@color/text_secondary"
            android:textSize="14sp"

            android:gravity="center"

            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp" />


        <!-- ===================================================== -->
        <!-- STEP PROGRESS                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:paddingStart="4dp"
            android:paddingEnd="4dp"

            android:layout_marginBottom="22dp">


            <!-- STEP 1 -->

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"

                android:background="@color/card_dark" />


            <View
                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"

                android:background="@color/primary" />


            <!-- STEP 2 -->

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"

                android:background="@color/card_dark" />


            <View
                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"

                android:background="@color/primary" />


            <!-- STEP 3 -->

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"

                android:background="@color/card_dark" />


            <View
                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"

                android:background="@color/primary" />


            <!-- STEP 4 -->

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"

                android:background="@color/card_dark" />


            <View
                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"

                android:background="@color/primary" />


            <!-- STEP 5 - ACTIVE -->

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:gravity="center"

                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"

                android:background="@color/primary" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- PERSONAL DETAILS                                     -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:text="●"
                        android:textColor="@color/primary"
                        android:textSize="22sp"

                        android:background="@color/card_dark" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="12dp"

                        android:text="Personal Details"

                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/btnEditPersonal"

                        android:layout_width="wrap_content"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"

                        android:text="✎  Edit"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        android:clickable="true"
                        android:focusable="true"

                        android:contentDescription="Edit Personal Details"

                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"

                    android:background="?attr/colorOutline" />


                <TextView
                    android:id="@+id/tvFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="First Name        --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvMiddleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Middle Name      --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Last Name         --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Date of Birth     --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Gender             --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- CONTACT DETAILS                                      -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:text="☎"
                        android:textColor="@color/primary"
                        android:textSize="21sp"

                        android:background="@color/card_dark" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="12dp"

                        android:text="Contact Details"

                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/btnEditContact"

                        android:layout_width="wrap_content"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"

                        android:text="✎  Edit"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        android:clickable="true"
                        android:focusable="true"

                        android:contentDescription="Edit Contact Details"

                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"

                    android:background="?attr/colorOutline" />


                <TextView
                    android:id="@+id/tvMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Mobile Number    --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Email Address     --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- GOVERNMENT DETAILS                                   -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:text="▣"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"

                        android:background="@color/card_dark" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="12dp"

                        android:text="Government Details"

                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/btnEditGovernment"

                        android:layout_width="wrap_content"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"

                        android:text="✎  Edit"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        android:clickable="true"
                        android:focusable="true"

                        android:contentDescription="Edit Government Details"

                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"

                    android:background="?attr/colorOutline" />


                <TextView
                    android:id="@+id/tvAadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Aadhaar Number   --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvPan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="PAN Number        --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- ADDRESS DETAILS                                      -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:text="●"
                        android:textColor="@color/primary"
                        android:textSize="23sp"

                        android:background="@color/card_dark" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="12dp"

                        android:text="Address Details"

                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/btnEditAddress"

                        android:layout_width="wrap_content"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"

                        android:text="✎  Edit"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        android:clickable="true"
                        android:focusable="true"

                        android:contentDescription="Edit Address Details"

                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"

                    android:background="?attr/colorOutline" />


                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Address            --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="City                --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="State               --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvPincode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Pincode             --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- EMPLOYMENT DETAILS                                   -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:text="▣"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"

                        android:background="@color/card_dark" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="12dp"

                        android:text="Employment Details"

                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/btnEditEmployment"

                        android:layout_width="wrap_content"
                        android:layout_height="44dp"

                        android:gravity="center"

                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"

                        android:text="✎  Edit"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        android:clickable="true"
                        android:focusable="true"

                        android:contentDescription="Edit Employment Details"

                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"

                    android:background="?attr/colorOutline" />


                <TextView
                    android:id="@+id/tvOccupation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Occupation         --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/tvAccountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Account Type       --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- SECURITY INFORMATION                                 -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:padding="15dp">


                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"

                    android:gravity="center"

                    android:text="✓"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold"

                    android:background="@color/card_dark" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="vertical"
                    android:layout_marginStart="12dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Your information is secure"

                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Your information is securely submitted for KYC verification."

                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"

                        android:lineSpacingExtra="2dp"

                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- SUBMIT                                                -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:text="Submit KYC     →"
            android:textAllCaps="false"

            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"

            android:fontFamily="sans"
            android:gravity="center"

            app:backgroundTint="@color/primary"
            app:cornerRadius="29dp"
            app:elevation="3dp"

            app:rippleColor="#55FFFFFF" />


        <!-- ===================================================== -->
        <!-- FOOTER                                                -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="By submitting, you confirm that the information provided is accurate and belongs to you."

            android:textColor="@color/text_secondary"
            android:textSize="11sp"

            android:gravity="center"

            android:lineSpacingExtra="2dp"

            android:layout_marginTop="12dp"

            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/app_name"

            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="@string/account_details"

            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="@string/complete_account_information"

            android:textColor="@color/text_secondary"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressBar"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginTop="30dp"

            android:indeterminateTint="@color/primary"

            android:visibility="gone" />


        <!-- ================================================= -->
        <!-- ACCOUNT INFORMATION -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/admin_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="22dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/account_information"

                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- ACCOUNT NUMBER -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:text="@string/account_number"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvAccountNumber"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"

                    tools:text="202600000001" />


                <!-- ACCOUNT TYPE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/account_type"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvAccountType"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"

                    tools:text="SAVINGS" />


                <!-- BRANCH -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/branch"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvBranch"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"

                    tools:text="Main Branch" />


                <!-- IFSC -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/ifsc_code"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvIfsc"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"

                    tools:text="BANK0001001" />


                <!-- CURRENT BALANCE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/current_balance"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvBalance"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/success"
                    android:textSize="24sp"
                    android:textStyle="bold"

                    tools:text="₹ 11254.00" />


                <!-- ACCOUNT STATUS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/account_status"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    tools:text="ACTIVE" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- CUSTOMER INFORMATION -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/admin_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="22dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/customer_information"

                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- CUSTOMER NAME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:text="@string/customer_name"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvCustomerName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"

                    tools:text="Rohit Vishwakarma" />


                <!-- CUSTOMER ID -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/customer_id"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvCustomerId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"

                    tools:text="CUS000001" />


                <!-- USERNAME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/username"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvUsername"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    tools:text="@rohitvishwakarma" />


                <!-- MOBILE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/mobile_number"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvMobile"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"

                    tools:text="9876543211" />


                <!-- EMAIL -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="@string/email_address"

                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvEmail"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:autoLink="email"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"

                    tools:text="rohit.new@gmail.com" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- STATUS / TRANSACTIONS -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/admin_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="22dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="@string/account_status"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvStatusBadge"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:textColor="@color/success"
                        android:textSize="14sp"
                        android:textStyle="bold"

                        tools:text="● ACTIVE" />

                </LinearLayout>


                <!-- VIEW TRANSACTIONS -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewTransactions"

                    android:layout_width="match_parent"
                    android:layout_height="48dp"

                    android:layout_marginTop="18dp"

                    android:text="@string/view_transactions"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"

                    app:backgroundTint="@color/primary"
                    app:cornerRadius="24dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"

    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">


        <!-- ================================================= -->
        <!-- TRANSACTION TYPE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvHistoryTransactionType"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="RD INSTALLMENT"

            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- AMOUNT -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvHistoryAmount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="₹5,000.00"

            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- DATE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvHistoryDate"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="16 Aug 2026, 03:30 PM"

            android:textColor="@color/text_secondary"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- PAYMENT MODE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvHistoryPaymentMode"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="ACCOUNT DEBIT"

            android:textColor="@color/text_secondary"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- STATUS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvHistoryStatus"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="SUCCESS"

            android:textColor="@color/success"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- REMARKS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvHistoryRemarks"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Recurring Deposit Installment"

            android:textColor="@color/text_secondary"
            android:textSize="12sp" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
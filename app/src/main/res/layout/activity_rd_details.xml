<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">


        <!-- ================================================= -->
        <!-- DETAILS CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="16dp">


                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Recurring Deposit Details"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- RD NUMBER -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="RD Number"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRDNumber"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="RD202600001"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- ACCOUNT NUMBER -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Account Number"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountNumber"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="1002003001"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- CUSTOMER NAME -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Customer Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCustomerName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Customer"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- MONTHLY INSTALLMENT -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Monthly Installment"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMonthlyInstallment"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="₹5000"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- INTEREST RATE -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Interest Rate"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInterestRate"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="7.25%"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- TENURE -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Tenure"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTenure"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="24 Months"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- TOTAL DEPOSIT -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Total Deposit"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalDeposit"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="₹120000"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- MATURITY AMOUNT -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Maturity Amount"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaturityAmount"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="₹130200"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- PAID INSTALLMENTS -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Paid Installments"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPaidInstallments"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="12"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- REMAINING INSTALLMENTS -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Remaining Installments"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRemainingInstallments"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="12"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- NEXT INSTALLMENT -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Next Installment"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNextInstallment"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="15 Aug 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Status"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="ACTIVE"
                    android:textColor="@color/success"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- PAY INSTALLMENT -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayInstallment"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:layout_marginTop="24dp"

                    android:text="Pay Installment"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    app:cornerRadius="14dp" />


                <!-- ================================================= -->
                <!-- HISTORY -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistory"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:layout_marginTop="12dp"

                    android:text="Installment History"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    app:cornerRadius="14dp" />


                <!-- ================================================= -->
                <!-- PREMATURE CLOSE -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrematureClose"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:layout_marginTop="12dp"

                    android:text="Premature Close"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    app:cornerRadius="14dp" />


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
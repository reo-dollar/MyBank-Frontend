<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="12dp"

    app:cardBackgroundColor="@color/admin_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/admin_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="16dp">


        <!-- ================================================= -->
        <!-- ACCOUNT TYPE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvAccountType"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textColor="@color/admin_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"

            tools:text="SAVINGS" />


        <!-- ================================================= -->
        <!-- ACCOUNT NUMBER -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvAccountNumber"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:textColor="@color/admin_primary"
            android:textSize="13sp"

            tools:text="Account No: 202600000001" />


        <!-- ================================================= -->
        <!-- CUSTOMER NAME -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvCustomerName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:textColor="@color/admin_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"

            tools:text="Rohit Vishwakarma" />


        <!-- ================================================= -->
        <!-- CUSTOMER ID -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvCustomerId"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:textColor="@color/admin_text_secondary"
            android:textSize="12sp"

            tools:text="Customer ID: CUS000001" />


        <!-- ================================================= -->
        <!-- BALANCE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvBalance"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:textColor="@color/admin_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"

            tools:text="Balance: ₹11,254.00" />


        <!-- ================================================= -->
        <!-- STATUS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:textColor="@color/admin_success"
            android:textSize="13sp"
            android:textStyle="bold"

            tools:text="● ACTIVE" />


        <!-- ================================================= -->
        <!-- DETAILS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvViewDetails"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:clickable="true"
            android:focusable="true"

            android:text="@string/admin_view_account_details"

            android:textColor="@color/admin_primary"
            android:textSize="13sp"

            tools:text="Tap to view details →" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
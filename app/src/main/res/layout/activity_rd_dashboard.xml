<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:fillViewport="true"

    tools:context=".activities.payments.recurringdeposit.RDDashboardActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="20dp">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Recurring Deposit"

            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Manage your recurring deposits"

            android:textColor="@color/text_secondary"
            android:textSize="15sp" />


        <!-- ===================================================== -->
        <!-- OPEN NEW RD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardOpenRD"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/success"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Open New RD"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Start a new Recurring Deposit"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- RD CALCULATOR -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardCalculator"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="@color/primary"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="RD Calculator"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Estimate your maturity amount"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- MY RECURRING DEPOSITS -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardMyRD"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_menu_agenda"
                    android:tint="@color/admin_loan"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="My Recurring Deposits"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="View all your RD accounts"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- PAY INSTALLMENT -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardPayInstallment"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_menu_send"
                    android:tint="@color/admin_transaction"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Pay Installment"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Pay your monthly RD installment"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- RD HISTORY -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardHistory"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_menu_recent_history"
                    android:tint="@color/text_secondary"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="RD History"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="View all installment history"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- MATURED RD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardMatured"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="@color/success"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Matured RD"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="View matured recurring deposits"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- PREMATURE CLOSURE -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardPrematureClose"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:padding="18dp">


                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:src="@android:drawable/ic_delete"
                    android:tint="@color/error"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="16dp"
                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Premature Closure"

                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Close your RD before maturity"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>
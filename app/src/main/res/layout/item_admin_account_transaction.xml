<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"

    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/admin_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="18dp">


        <!-- ================================================= -->
        <!-- TYPE + AMOUNT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tvTransactionType"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:ellipsize="end"
                android:maxLines="1"

                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"

                tools:text="RD_INSTALLMENT" />


            <TextView
                android:id="@+id/tvTransactionAmount"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"

                android:textColor="@color/error"
                android:textSize="17sp"
                android:textStyle="bold"

                tools:text="- ₹500.00" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TRANSACTION ID -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTransactionId"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"

            tools:text="Transaction ID: #119" />


        <!-- ================================================= -->
        <!-- FROM ACCOUNT -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvFromAccount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"

            tools:text="Account: 202600000001" />


        <!-- ================================================= -->
        <!-- TO ACCOUNT -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvToAccount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"

            tools:text="To: 202600000002" />


        <!-- ================================================= -->
        <!-- REMARKS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvRemarks"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:textColor="@color/text_secondary"
            android:textSize="14sp"

            tools:text="No remarks" />


        <!-- ================================================= -->
        <!-- TIMESTAMP -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTimestamp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="7dp"

            android:textColor="@color/text_muted"
            android:textSize="13sp"

            tools:text="14 Aug 2026, 11:47 PM" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="14dp"

    android:clickable="true"
    android:focusable="true"

    app:cardBackgroundColor="@color/admin_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/admin_blue_stroke"
    app:strokeColor="@color/admin_divider"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="17dp">


        <!-- ===================================================== -->
        <!-- CUSTOMER NAME -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvCustomerFullName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Customer Name"

            android:textColor="@color/admin_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"

            android:maxLines="2"
            android:ellipsize="end" />


        <!-- ===================================================== -->
        <!-- USERNAME -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvCustomerUsername"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Username"

            android:textColor="@color/admin_primary"
            android:textSize="14sp"

            android:maxLines="1"
            android:ellipsize="end" />


        <!-- ===================================================== -->
        <!-- CUSTOMER INFORMATION -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="13dp"

            android:orientation="vertical">


            <!-- CUSTOMER ID -->

            <TextView
                android:id="@+id/tvCustomerId"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Customer ID"

                android:textColor="@color/admin_text_secondary"
                android:textSize="14sp"

                android:maxLines="2"
                android:ellipsize="end" />


            <!-- EMAIL -->

            <TextView
                android:id="@+id/tvCustomerEmail"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:text="Email address"

                android:textColor="@color/admin_text_secondary"
                android:textSize="14sp"

                android:maxLines="2"
                android:ellipsize="end" />


            <!-- MOBILE -->

            <TextView
                android:id="@+id/tvCustomerMobile"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:text="Mobile number"

                android:textColor="@color/admin_text_secondary"
                android:textSize="14sp"

                android:maxLines="1"
                android:ellipsize="end" />


            <!-- ROLE -->

            <TextView
                android:id="@+id/tvCustomerRole"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:text="Role"

                android:textColor="@color/admin_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- STATUS -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvCustomerStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="Status"

            android:textColor="@color/admin_success"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- VIEW DETAILS -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvCustomerViewDetails"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="13dp"

            android:paddingTop="2dp"
            android:paddingBottom="2dp"

            android:text="@string/admin_view_customer_details"

            android:textColor="@color/admin_primary"
            android:textSize="13sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">


        <!-- ========================================================= -->
        <!-- PROGRESS                                                   -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- STEP 1 - ACTIVE -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:gravity="center"

                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_active"
                android:backgroundTint="@color/primary"

                android:padding="8dp" />


            <!-- CONNECTOR -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"

                android:layout_weight="1"

                android:background="@color/primary" />


            <!-- STEP 2 -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:gravity="center"

                android:text="2"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"

                android:background="@drawable/bg_step_inactive"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"

                android:layout_weight="1"

                android:background="?attr/colorOutline" />


            <!-- STEP 3 -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:gravity="center"

                android:text="3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"

                android:background="@drawable/bg_step_inactive"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"

                android:layout_weight="1"

                android:background="?attr/colorOutline" />


            <!-- STEP 4 -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:gravity="center"

                android:text="4"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"

                android:background="@drawable/bg_step_inactive"
                android:backgroundTint="@color/card_dark" />


            <!-- CONNECTOR -->

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"

                android:layout_weight="1"

                android:background="?attr/colorOutline" />


            <!-- STEP 5 -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:gravity="center"

                android:text="5"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"

                android:background="@drawable/bg_step_inactive"
                android:backgroundTint="@color/card_dark" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- CURRENT STEP                                               -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:text="Step 1 of 5"

            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- TITLE                                                       -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Personal Details"

            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- SUBTITLE                                                    -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Let's start with your basic information"

            android:textColor="@color/text_secondary"
            android:textSize="14sp" />


        <!-- ========================================================= -->
        <!-- FIRST NAME                                                  -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:hint="First Name"

            app:boxBackgroundColor="@color/surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:boxStrokeColor="?attr/colorOutline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"

            app:hintTextColor="@color/text_secondary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFirstName"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:inputType="textPersonName"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"

                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- MIDDLE NAME                                                 -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:hint="Middle Name (Optional)"

            app:boxBackgroundColor="@color/surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:boxStrokeColor="?attr/colorOutline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"

            app:hintTextColor="@color/text_secondary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMiddleName"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:inputType="textPersonName"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"

                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- LAST NAME                                                   -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:hint="Last Name"

            app:boxBackgroundColor="@color/surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:boxStrokeColor="?attr/colorOutline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"

            app:hintTextColor="@color/text_secondary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLastName"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:inputType="textPersonName"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"

                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- DATE OF BIRTH                                               -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:hint="Date of Birth"

            app:boxBackgroundColor="@color/surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:boxStrokeColor="?attr/colorOutline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"

            app:hintTextColor="@color/text_secondary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDob"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:focusable="false"
                android:clickable="true"

                android:inputType="none"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"

                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- GENDER                                                      -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="Gender"

            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="8dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <Spinner
                android:id="@+id/spGender"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:paddingStart="16dp"
                android:paddingEnd="12dp"

                android:entries="@array/gender_array"
                android:spinnerMode="dropdown" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- NEXT BUTTON                                                 -->
        <!-- ========================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="24dp"

            android:text="Next  →"
            android:textAllCaps="false"

            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"

            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:elevation="3dp" />


    </LinearLayout>

</ScrollView>
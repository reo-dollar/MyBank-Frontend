                    android:paddingEnd="4dp"

                    android:insetTop="0dp"
                    android:insetBottom="0dp"

                    android:minHeight="0dp"

                    android:text="USER MANAGEMENT"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"

                    android:maxLines="2"
                    android:ellipsize="none"

                    app:backgroundTint="@color/admin_primary"
                    app:cornerRadius="18dp"
                    app:elevation="3dp" />


                <!-- CUSTOMER MANAGEMENT -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomerManagement"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"

                    android:layout_marginStart="6dp"

                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"

                    android:insetTop="0dp"
                    android:insetBottom="0dp"

                    android:minHeight="0dp"

                    android:text="CUSTOMER MANAGEMENT"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"

                    android:maxLines="2"
                    android:ellipsize="none"

                    app:backgroundTint="@color/admin_customer"
                    app:cornerRadius="18dp"
                    app:elevation="3dp" />

            </LinearLayout>


            <!-- ========================================================= -->
            <!-- MANAGEMENT ROW 2                                         -->
            <!-- ========================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"

                android:layout_marginTop="12dp"

                android:orientation="horizontal"
                android:weightSum="2">

                <!-- ACCOUNT MANAGEMENT -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccountManagement"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"

                    android:layout_marginEnd="6dp"

                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"

                    android:insetTop="0dp"
                    android:insetBottom="0dp"

                    android:minHeight="0dp"

                    android:text="ACCOUNT MANAGEMENT"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"

                    android:maxLines="2"
                    android:ellipsize="none"

                    app:backgroundTint="@color/admin_account"
                    app:cornerRadius="18dp"
                    app:elevation="3dp" />


                <!-- TRANSACTION MANAGEMENT -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTransactionManagement"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"

                    android:layout_marginStart="6dp"

                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"

                    android:insetTop="0dp"
                    android:insetBottom="0dp"

                    android:minHeight="0dp"

                    android:text="TRANSACTION MANAGEMENT"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"

                    android:maxLines="2"
                    android:ellipsize="none"

                    app:backgroundTint="@color/admin_transaction"
                    app:cornerRadius="18dp"
                    app:elevation="3dp" />

            </LinearLayout>


            <!-- ========================================================= -->
            <!-- LOAN MANAGEMENT                                          -->
            <!-- ========================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoanManagement"

                android:layout_width="match_parent"
                android:layout_height="64dp"

                android:layout_marginTop="12dp"

                android:gravity="center"

                android:insetTop="0dp"
                android:insetBottom="0dp"

                android:minHeight="0dp"

                android:text="LOAN MANAGEMENT"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"

                app:backgroundTint="@color/admin_loan"
                app:cornerRadius="18dp"
                app:elevation="3dp" />


            <!-- ========================================================= -->
            <!-- DIVIDER                                                   -->
            <!-- ========================================================= -->

            <View

<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:orientation="vertical">


    <!-- ===================================================== -->
    <!-- APP BAR                                               -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:background="@color/primary_dark"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:paddingStart="8dp"
        android:paddingEnd="16dp">


        <!-- BACK BUTTON -->

        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="52dp"
            android:layout_height="52dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Back"

            android:padding="14dp"

            android:src="@drawable/ic_arrow_back"

            app:tint="@android:color/white" />


        <!-- TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="My QR"

            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT                                               -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true"
        android:clipToPadding="false">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_horizontal"

            android:orientation="vertical"

            android:padding="20dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- MAIN CARD                                          -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@drawable/bg_my_qr_card"

                android:elevation="3dp"

                android:gravity="center_horizontal"

                android:orientation="vertical"

                android:padding="20dp">


                <!-- ============================================= -->
                <!-- AVATAR                                         -->
                <!-- ============================================= -->

                <TextView
                    android:id="@+id/tvAvatar"

                    android:layout_width="72dp"
                    android:layout_height="72dp"

                    android:background="@color/card_dark"

                    android:gravity="center"

                    android:text="?"

                    android:textColor="@color/primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />


                <!-- ============================================= -->
                <!-- NAME                                           -->
                <!-- ============================================= -->

                <TextView
                    android:id="@+id/tvCustomerName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:gravity="center"

                    android:text="Loading..."

                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />


                <!-- ============================================= -->
                <!-- SUBTITLE                                       -->
                <!-- ============================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:gravity="center"

                    android:text="Scan this QR to pay me"

                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ============================================= -->
                <!-- QR CONTAINER                                   -->
                <!-- ============================================= -->

                <FrameLayout
                    android:layout_width="280dp"
                    android:layout_height="280dp"

                    android:layout_marginTop="22dp"

                    android:background="@color/white"

                    android:elevation="4dp"

                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/imgQrCode"

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:contentDescription="My personal payment QR code"

                        android:scaleType="fitCenter" />


                    <ProgressBar
                        android:id="@+id/qrProgress"

                        android:layout_width="48dp"
                        android:layout_height="48dp"

                        android:layout_gravity="center"

                        android:visibility="visible" />

                </FrameLayout>


                <!-- ============================================= -->
                <!-- PAYMENT ID                                     -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:background="@drawable/bg_payment_id"

                    android:gravity="center_vertical"

                    android:orientation="horizontal"

                    android:padding="14dp">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Payment ID"

                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />


                        <TextView
                            android:id="@+id/tvPaymentId"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:ellipsize="middle"

                            android:maxLines="2"

                            android:text="PAY_..."

                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- COPY -->

                    <ImageButton
                        android:id="@+id/btnCopyPaymentId"

                        android:layout_width="46dp"
                        android:layout_height="46dp"

                        android:background="?attr/selectableItemBackgroundBorderless"

                        android:contentDescription="Copy Payment ID"

                        android:padding="10dp"

                        android:src="@drawable/ic_content_copy_24"

                        app:tint="@color/primary" />

                </LinearLayout>


                <!-- ============================================= -->
                <!-- INFO                                           -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:background="@drawable/bg_qr_info"

                    android:gravity="center_vertical"

                    android:orientation="horizontal"

                    android:padding="14dp">


                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"

                        android:contentDescription="Information"

                        android:src="@drawable/ic_info_24"

                        app:tint="@color/primary" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="12dp"

                        android:layout_weight="1"

                        android:text="Share this QR with anyone to receive payments directly to your bank account."

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- ============================================= -->
                <!-- BUTTONS                                        -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:orientation="horizontal">


                    <!-- SHARE QR -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareQr"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_marginEnd="6dp"

                        android:layout_weight="1"

                        android:text="Share QR"
                        android:textAllCaps="false"

                        android:textColor="@color/primary"

                        android:textSize="15sp"
                        android:textStyle="bold"

                        app:backgroundTint="@color/surface"

                        app:cornerRadius="26dp"

                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />


                    <!-- SAVE QR -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveQr"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_marginStart="6dp"

                        android:layout_weight="1"

                        android:text="Save QR"
                        android:textAllCaps="false"

                        android:textColor="@android:color/white"

                        android:textSize="15sp"
                        android:textStyle="bold"

                        app:backgroundTint="@color/primary"

                        app:cornerRadius="26dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
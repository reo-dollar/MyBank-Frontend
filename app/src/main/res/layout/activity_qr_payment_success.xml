<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="@color/background">


    <!-- ========================================================= -->
    <!-- APP BAR -->
    <!-- ========================================================= -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"

        android:background="@color/primary_dark">

        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="Payment"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:gravity="center_horizontal"

            android:padding="24dp">


            <!-- ================================================= -->
            <!-- SUCCESS ICON -->
            <!-- ================================================= -->

            <FrameLayout

                android:layout_width="96dp"
                android:layout_height="96dp"

                android:layout_marginTop="32dp"

                android:background="@drawable/bg_qr_success_circle">

                <TextView
                    android:id="@+id/tvSuccessIcon"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:textStyle="bold"/>

            </FrameLayout>


            <!-- ================================================= -->
            <!-- SUCCESS TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSuccessTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:text="Payment Successful"
                android:textColor="@color/text_primary"
                android:textSize="25sp"
                android:textStyle="bold"/>


            <!-- ================================================= -->
            <!-- SUCCESS SUBTITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSuccessSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="Your payment has been completed successfully."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"/>


            <!-- ================================================= -->
            <!-- PAYMENT CARD -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:orientation="vertical"
                android:padding="22dp"

                android:background="@drawable/bg_qr_success_card">


                <!-- ================================================= -->
                <!-- AMOUNT LABEL -->
                <!-- ================================================= -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Amount Paid"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center"/>


                <!-- ================================================= -->
                <!-- AMOUNT -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/tvAmount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="₹0.00"
                    android:textColor="@color/primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"/>


                <!-- ================================================= -->
                <!-- DIVIDER -->
                <!-- ================================================= -->

                <View

                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"

                    android:background="?attr/colorOutline"/>


                <!-- ================================================= -->
                <!-- RECIPIENT -->
                <!-- ================================================= -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Paid to"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <!-- RECIPIENT NAME -->

                <TextView
                    android:id="@+id/tvRecipientName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Recipient Name"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>


                <!-- ACCOUNT NUMBER -->

                <TextView
                    android:id="@+id/tvMaskedAccount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="XXXXXXXX0003"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>


                <!-- ================================================= -->
                <!-- PAYMENT REFERENCE -->
                <!-- ================================================= -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="22dp"

                    android:text="Payment Reference"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <!-- PAYMENT ID -->

                <TextView
                    android:id="@+id/tvPaymentId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="PAY_XXXXXXXX"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"

                    android:fontFamily="monospace"

                    android:breakStrategy="balanced"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INFORMATION -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:padding="16dp"

                android:background="@drawable/bg_qr_success_info">


                <!-- INFO ICON -->

                <ImageView

                    android:layout_width="22dp"
                    android:layout_height="22dp"

                    android:src="@drawable/ic_info_24"

                    app:tint="@color/primary"/>


                <!-- INFO TEXT -->

                <TextView

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="12dp"

                    android:text="Keep this payment reference for your records."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DONE BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnDone"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"

                android:text="Back to Home"
                android:textAllCaps="false"

                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"

                android:background="@drawable/bg_qr_success_button"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
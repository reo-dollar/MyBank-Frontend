<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/bg_dashboard">


    <!-- ====================================================== -->
    <!-- DASHBOARD CONTENT -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="72dp"
            android:paddingBottom="110dp">


            <!-- ====================================================== -->
            <!-- HEADER -->
            <!-- ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <!-- ================================================== -->
                <!-- GREETING / WELCOME -->
                <!-- ================================================== -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="vertical">


                    <!-- Greeting -->

                    <TextView
                        android:id="@+id/tvGreeting"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="☀️ Good Morning"

                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />


                    <!-- Greeting Message -->

                    <TextView
                        android:id="@+id/tvGreetingMessage"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="Have a great day ahead!"

                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />


                    <!-- Welcome -->

                    <TextView
                        android:id="@+id/tvWelcome"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:text="Welcome"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="22sp"

                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp" />


                </LinearLayout>


                <!-- ================================================== -->
                <!-- MY QR BUTTON -->
                <!-- ================================================== -->

                <ImageButton
                    android:id="@+id/btnMyQr"

                    android:layout_width="56dp"
                    android:layout_height="56dp"

                    android:background="?attr/selectableItemBackgroundBorderless"

                    android:padding="12dp"

                    android:src="@drawable/ic_qr_code_24"

                    android:scaleType="centerInside"

                    android:contentDescription="My QR"

                    app:tint="@color/primary" />


                <!-- ================================================== -->
                <!-- PROFILE BUTTON -->
                <!-- ================================================== -->

                <ImageButton
                    android:id="@+id/btnProfile"

                    android:layout_width="56dp"
                    android:layout_height="56dp"

                    android:background="?attr/selectableItemBackgroundBorderless"

                    android:padding="12dp"

                    android:src="@android:drawable/ic_menu_myplaces"

                    android:scaleType="centerInside"

                    android:contentDescription="Profile" />


            </LinearLayout>


            <!-- ====================================================== -->
            <!-- PREMIUM BALANCE CARD -->
            <!-- ====================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalance"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                app:cardCornerRadius="28dp"
                app:cardElevation="3dp"

                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline"

                app:cardBackgroundColor="@color/surface">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:background="@drawable/bg_balance_card"

                    android:padding="24dp">


                    <!-- Savings Account -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Savings Account"

                        android:textColor="@android:color/white"

                        android:textStyle="bold"
                        android:textSize="17sp" />


                    <!-- ====================================================== -->
                    <!-- AVAILABLE BALANCE -->
                    <!-- ====================================================== -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="22dp"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:text="Available Balance"

                            android:textColor="#E3F2FD"

                            android:textSize="14sp" />


                        <ImageView
                            android:id="@+id/imgToggleBalance"

                            android:layout_width="22dp"
                            android:layout_height="22dp"

                            android:padding="2dp"

                            android:src="@drawable/ic_visibility_24"

                            app:tint="@android:color/white"

                            android:contentDescription="Show or hide balance" />


                    </LinearLayout>


                    <!-- Balance -->

                    <TextView
                        android:id="@+id/tvBalance"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:text="₹ •••••••"

                        android:textColor="@android:color/white"

                        android:textStyle="bold"
                        android:textSize="34sp" />


                    <!-- Divider -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="20dp"

                        android:background="#40FFFFFF" />


                    <!-- ====================================================== -->
                    <!-- ACCOUNT NUMBER -->
                    <!-- ====================================================== -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Account Number"

                                android:textColor="#E3F2FD"

                                android:textSize="13sp" />


                            <TextView
                                android:id="@+id/tvAccountNumber"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="4dp"

                                android:text="XXXX XXXX 0000"

                                android:textColor="@android:color/white"

                                android:textStyle="bold"
                                android:textSize="18sp" />


                        </LinearLayout>


                        <ImageView
                            android:id="@+id/imgToggleAccount"

                            android:layout_width="22dp"
                            android:layout_height="22dp"

                            android:padding="2dp"

                            android:src="@drawable/ic_visibility_24"

                            app:tint="@android:color/white"

                            android:contentDescription="Show or hide account number" />


                    </LinearLayout>


                    <!-- Divider -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"

                        android:background="#40FFFFFF" />


                    <!-- ====================================================== -->
                    <!-- ACCOUNT DETAILS ROW 1 -->
                    <!-- ====================================================== -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">


                        <!-- Account Type -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Account Type"

                                android:textColor="#E3F2FD"

                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/tvAccountType"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Savings"

                                android:textColor="@android:color/white"

                                android:textStyle="bold" />


                        </LinearLayout>


                        <!-- Branch -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Branch"

                                android:textColor="#E3F2FD"

                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/tvBranch"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Main Branch"

                                android:textColor="@android:color/white"

                                android:textStyle="bold" />


                        </LinearLayout>


                    </LinearLayout>


                    <!-- ====================================================== -->
                    <!-- ACCOUNT DETAILS ROW 2 -->
                    <!-- ====================================================== -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="18dp"

                        android:orientation="horizontal">


                        <!-- IFSC -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="IFSC"

                                android:textColor="#E3F2FD"

                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/tvIfsc"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="BANK0001001"

                                android:textColor="@android:color/white"

                                android:textStyle="bold" />


                        </LinearLayout>


                        <!-- Status -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Status"

                                android:textColor="#E3F2FD"

                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/tvStatus"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="ACTIVE"

                                android:textColor="#8CFF8C"

                                android:textStyle="bold" />


                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <!-- ====================================================== -->
            <!-- QUICK ACTIONS -->
            <!-- ====================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="30dp"
                android:layout_marginBottom="18dp"

                android:text="Quick Actions"

                android:textColor="@color/text_primary"

                android:textStyle="bold"
                android:textSize="22sp" />


            <!-- ====================================================== -->
            <!-- QUICK ACTION ROW 1 -->
            <!-- ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">


                <!-- Deposit -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDeposit"

                    android:layout_width="0dp"
                    android:layout_height="135dp"

                    android:layout_weight="1"

                    android:layout_marginEnd="10dp"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"

                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"

                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"

                    app:cardBackgroundColor="@color/surface">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="18dp">


                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_account_balance_wallet_24"

                            app:tint="@color/primary"

                            android:contentDescription="Deposit" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:text="Deposit"

                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:textSize="15sp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <!-- Withdraw -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWithdraw"

                    android:layout_width="0dp"
                    android:layout_height="135dp"

                    android:layout_weight="1"

                    android:layout_marginStart="10dp"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"

                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"

                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"

                    app:cardBackgroundColor="@color/surface">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="18dp">


                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_arrow_upward_24"

                            app:tint="@color/primary"

                            android:contentDescription="Withdraw" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:text="Withdraw"

                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:textSize="15sp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


            <!-- ====================================================== -->
            <!-- QUICK ACTION ROW 2 -->
            <!-- ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="horizontal">


                <!-- Transfer -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTransfer"

                    android:layout_width="0dp"
                    android:layout_height="135dp"

                    android:layout_weight="1"

                    android:layout_marginEnd="10dp"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"

                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"

                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"

                    app:cardBackgroundColor="@color/surface">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="18dp">


                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_swap_horiz_24"

                            app:tint="@color/primary"

                            android:contentDescription="Transfer" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:text="Transfer"

                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:textSize="15sp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <!-- History -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistory"

                    android:layout_width="0dp"
                    android:layout_height="135dp"

                    android:layout_weight="1"

                    android:layout_marginStart="10dp"

                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"

                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"

                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"

                    app:cardBackgroundColor="@color/surface">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="18dp">


                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"

                            android:src="@drawable/ic_history_24"

                            app:tint="@color/primary"

                            android:contentDescription="History" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:text="History"

                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:textSize="15sp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


            <!-- ====================================================== -->
            <!-- RECENT TRANSACTIONS TITLE -->
            <!-- ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="30dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="Recent Transactions"

                    android:textColor="@color/text_primary"

                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvViewAll"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="View All"

                    android:textColor="@color/primary"

                    android:textStyle="bold" />


            </LinearLayout>


            <!-- Recent Transactions RecyclerView -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentTransactions"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:nestedScrollingEnabled="false"

                android:overScrollMode="never" />


        </LinearLayout>


    </androidx.core.widget.NestedScrollView>


    <!-- ====================================================== -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ====================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavContainer"

        android:layout_width="0dp"
        android:layout_height="90dp"

        android:layout_margin="12dp"

        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"

        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutline"

        app:cardBackgroundColor="@color/surface"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@android:color/transparent"

            app:itemHorizontalTranslationEnabled="false"

            app:itemIconTint="@color/bottom_nav_color"
            app:itemTextColor="@color/bottom_nav_color"

            app:itemIconSize="30dp"

            app:labelVisibilityMode="labeled"

            app:menu="@menu/bottom_menu" />


    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"
    android:background="@color/background"

    tools:context=".activities.payments.recurringdeposit.OpenRDActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="20dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Open Recurring Deposit"

            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Start saving every month"

            android:textColor="@color/text_secondary"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- ACCOUNT NUMBER -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAccountNumber"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:hint="Account Number"

            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccountNumber"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:longClickable="false"
                android:cursorVisible="false"
                android:importantForAutofill="no"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                tools:text="123456789012" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- MONTHLY INSTALLMENT -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMonthlyInstallment"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:hint="Monthly Installment (₹)"

            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMonthlyInstallment"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="numberDecimal"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- INTEREST RATE -->
        <!-- FIXED BY MYBANK -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutInterestRate"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <!-- Interest Rate Label -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Interest Rate"

                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />


                <!-- Rate + Fixed Text -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">

                    <!-- Fixed Interest Rate -->

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInterestRate"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:background="@android:color/transparent"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:clickable="false"
                        android:inputType="none"

                        android:paddingStart="0dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"

                        android:text="7.00% p.a."
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <!-- Fixed By MyBank -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="8dp"

                        android:text="Fixed by MyBank"

                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TENURE -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTenure"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:hint="Tenure (Months)"

            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTenure"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="number"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- AUTO DEBIT -->
        <!-- ================================================= -->

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoDebit"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="Enable Auto Debit"

            android:textColor="@color/text_primary" />


        <!-- ================================================= -->
        <!-- OPEN RD BUTTON -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenRD"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="24dp"

            android:text="Open Recurring Deposit"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"

            android:textColor="@android:color/white"

            app:backgroundTint="@color/primary"
            app:cornerRadius="18dp" />


        <!-- ================================================= -->
        <!-- IMPORTANT INFORMATION CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImportantInformation"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"

            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="16dp">


                <!-- ================================================= -->
                <!-- CARD TITLE -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Important Information"

                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- INFORMATION 1 -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="• Monthly installment will be automatically debited if Auto Debit is enabled."

                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ================================================= -->
                <!-- INFORMATION 2 -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="• Interest is calculated at the fixed bank rate of 7.00% per annum."

                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ================================================= -->
                <!-- INFORMATION 3 -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="• Premature closure may reduce the applicable interest."

                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

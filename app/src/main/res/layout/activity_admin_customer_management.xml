<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/admin_background">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"

        android:background="@color/admin_card">

        <!-- BRAND -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/my_bank"

            android:textColor="@color/admin_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>


        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Customer Management"

            android:textColor="@color/admin_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"/>


        <!-- CUSTOMER COUNT -->

        <TextView
            android:id="@+id/tvCustomerCount"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"

            android:text="0 customers"

            android:textColor="@color/admin_text_secondary"
            android:textSize="14sp"/>

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- SEARCH -->
    <!-- ====================================================== -->

    <com.google.android.material.textfield.TextInputLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"

        android:hint="Search customer, email, ID..."

        android:textColorHint="@color/admin_text_muted"

        app:boxBackgroundColor="@color/admin_card"

        app:boxStrokeColor="@color/admin_blue_stroke"

        app:hintTextColor="@color/admin_text_muted"

        app:startIconDrawable="@android:drawable/ic_menu_search"

        app:startIconTint="@color/admin_text_muted"

        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchCustomers"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:inputType="text"

            android:maxLines="1"

            android:textColor="@color/admin_text_primary"
            android:textColorHint="@color/admin_text_muted"/>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- ====================================================== -->
    <!-- LOADING -->
    <!-- ====================================================== -->

    <ProgressBar
        android:id="@+id/progressBar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_gravity="center_horizontal"

        android:indeterminateTint="@color/admin_primary"

        android:visibility="gone"/>


    <!-- ====================================================== -->
    <!-- EMPTY -->
    <!-- ====================================================== -->

    <TextView
        android:id="@+id/tvEmptyCustomers"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:padding="30dp"

        android:text="No customers found."

        android:textColor="@color/admin_text_secondary"
        android:textSize="16sp"

        android:visibility="gone"/>


    <!-- ====================================================== -->
    <!-- CUSTOMER LIST -->
    <!-- ====================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomers"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:clipToPadding="false"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"

        android:scrollbars="vertical"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="20dp">


        <!-- ========================================================= -->
        <!-- TITLE                                                       -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Payments"

            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"

            android:paddingTop="12dp" />


        <!-- ========================================================= -->
        <!-- BILLS PAYMENT                                               -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"

            android:text="Bills Payment"

            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- PAYMENT GRID                                                -->
        <!-- ========================================================= -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="true">


            <!-- ===================================================== -->
            <!-- MOBILE RECHARGE                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMobileRecharge"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_mobile"

                            app:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:gravity="center"

                        android:text="Mobile Recharge"

                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- ELECTRICITY                                            -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardElectricity"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_electricity"

                            app:tint="@color/admin_transaction" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Electricity"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- DTH                                                     -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDth"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_dth"

                            app:tint="@color/admin_loan" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="DTH"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- GAS CYLINDER                                           -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGas"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_gas"

                            app:tint="@color/admin_transaction" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Gas Cylinder"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- WATER BILL                                              -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWater"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_water"

                            app:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Water Bill"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- BROADBAND                                               -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBroadband"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_wifi"

                            app:tint="@color/success" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Broadband"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- FASTAG                                                  -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFastag"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_fastag"

                            app:tint="@color/error" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="FASTag"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- INSURANCE                                               -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInsurance"

                android:layout_width="0dp"
                android:layout_height="110dp"

                android:layout_columnWeight="1"
                android:layout_margin="8dp"

                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"

                        app:cardBackgroundColor="@color/card_dark"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">


                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_insurance"

                            app:tint="@color/accent" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Insurance"

                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </GridLayout>


        <!-- ========================================================= -->
        <!-- FINANCE                                                    -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"

            android:text="Finance"

            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- FIXED DEPOSIT                                              -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFixedDeposit"

            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginBottom="12dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:padding="18dp">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="💰 Fixed Deposit"

                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"

                    android:src="@drawable/ic_arrow_forward_24"

                    app:tint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- RECURRING DEPOSIT                                          -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecurringDeposit"

            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginBottom="12dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:padding="18dp">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="💵 Recurring Deposit"

                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"

                    android:src="@drawable/ic_arrow_forward_24"

                    app:tint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- LOANS                                                      -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoans"

            android:layout_width="match_parent"
            android:layout_height="70dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"
                android:padding="18dp">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="🏦 Loans"

                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"

                    android:src="@drawable/ic_arrow_forward_24"

                    app:tint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/admin_background">

    <!-- ========================================================= -->
    <!-- TOP APP BAR                                                -->
    <!-- ========================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"

        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"

        android:background="@color/admin_card"
        android:elevation="3dp"

        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/admin_customer_details"
        app:titleTextColor="@color/admin_text_primary" />


    <!-- ========================================================= -->
    <!-- MAIN CONTENT                                                -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true"
        android:clipToPadding="false"

        android:background="@color/admin_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- CUSTOMER PROFILE -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_horizontal"

                    android:orientation="vertical"

                    android:padding="24dp">

                    <!-- AVATAR -->

                    <TextView
                        android:id="@+id/tvCustomerAvatar"

                        android:layout_width="64dp"
                        android:layout_height="64dp"

                        android:background="@drawable/bg_customer_avatar"

                        android:gravity="center"

                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"

                        tools:text="R" />


                    <!-- NAME -->

                    <TextView
                        android:id="@+id/tvFullName"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:gravity="center"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold"

                        tools:text="Rohit Vishwakarma" />


                    <!-- USERNAME -->

                    <TextView
                        android:id="@+id/tvUsername"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:gravity="center"

                        android:textColor="@color/admin_primary"
                        android:textSize="14sp"

                        tools:text="@rohitvishwakarma" />


                    <!-- CUSTOMER ID -->

                    <TextView
                        android:id="@+id/tvCustomerId"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:gravity="center"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="13sp"

                        tools:text="CUS000001" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- BASIC INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_basic_information"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- DATE OF BIRTH -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/date_of_birth"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDateOfBirth"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="2003-05-20" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="13dp"

                        android:background="@color/admin_divider" />


                    <!-- GENDER -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/gender"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvGender"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="Male" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CONTACT INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_contact_information"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- MOBILE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/mobile_number"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMobile"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="9876543211" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="13dp"

                        android:background="@color/admin_divider" />


                    <!-- EMAIL -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/email_address"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvEmail"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="rohit.new@gmail.com" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- KYC INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_kyc_information"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- AADHAAR -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/aadhaar_number"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAadhaar"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="XXXX-XXXX-9012" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="13dp"

                        android:background="@color/admin_divider" />


                    <!-- PAN -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/pan_number"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPan"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="ABC****34F" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- ADDRESS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_address"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- ADDRESS -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/address"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAddress"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="123 Main Street" />


                    <!-- CITY -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:text="@string/city"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCity"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="Mumbai" />


                    <!-- STATE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:text="@string/state"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvState"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="Maharashtra" />


                    <!-- PINCODE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:text="@string/pincode"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPincode"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="400053" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- ADDITIONAL INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_additional_information"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- OCCUPATION -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/occupation"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOccupation"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="Software Engineer" />


                    <!-- CUSTOMER SINCE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:text="@string/customer_since"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCreatedAt"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="19 Jul 2026, 08:12 PM" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- ACCOUNT INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_account_information"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- ROLE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/role"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvRole"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        tools:text="USER" />


                    <!-- USER STATUS -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:text="@string/user_status"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvUserStatus"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:background="@drawable/bg_status_active"

                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"

                        android:textColor="@color/admin_success"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        tools:text="ACTIVE" />


                    <!-- ACCOUNT STATUS -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:text="@string/account_status"

                        android:textColor="@color/admin_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAccountStatus"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:background="@drawable/bg_status_active"

                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"

                        android:textColor="@color/admin_success"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        tools:text="Account Enabled" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- ACCOUNT ACTIONS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"

                android:text="@string/admin_account_actions"

                android:textColor="@color/admin_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="@color/admin_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <!-- ENABLE -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnableUser"

                        android:layout_width="match_parent"
                        android:layout_height="48dp"

                        android:text="@string/enable_user"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"

                        android:visibility="gone"

                        app:backgroundTint="@color/admin_success"
                        app:cornerRadius="24dp" />


                    <!-- DISABLE -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisableUser"

                        android:layout_width="match_parent"
                        android:layout_height="48dp"

                        android:layout_marginTop="10dp"

                        android:text="@string/disable_user"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"

                        android:visibility="visible"

                        app:backgroundTint="@color/admin_primary"
                        app:cornerRadius="24dp" />


                    <!-- LOCK -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLockAccount"

                        android:layout_width="match_parent"
                        android:layout_height="48dp"

                        android:layout_marginTop="10dp"

                        android:text="@string/lock_account"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"

                        android:visibility="visible"

                        app:backgroundTint="@color/admin_error"
                        app:cornerRadius="24dp" />


                    <!-- UNLOCK -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUnlockAccount"

                        android:layout_width="match_parent"
                        android:layout_height="48dp"

                        android:layout_marginTop="10dp"

                        android:text="@string/unlock_account"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"

                        android:visibility="gone"

                        app:backgroundTint="@color/admin_warning"
                        app:cornerRadius="24dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================================================= -->
    <!-- LOADING                                                     -->
    <!-- ========================================================= -->

    <ProgressBar
        android:id="@+id/progressBar"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:layout_gravity="center"

        android:visibility="gone" />

</LinearLayout>
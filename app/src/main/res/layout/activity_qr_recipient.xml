<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/background">


    <!-- ===================================================== -->
    <!-- APP BAR                                                -->
    <!-- ===================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:paddingStart="8dp"
        android:paddingEnd="16dp"

        android:background="@color/primary_dark">


        <ImageButton

            android:id="@+id/btnBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Back"

            android:padding="12dp"

            android:src="@drawable/ic_arrow_back"

            app:tint="@android:color/white" />


        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="Confirm Recipient"

            android:textColor="@android:color/white"

            android:textSize="20sp"

            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT                                                -->
    <!-- ===================================================== -->

    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">


            <!-- ================================================= -->
            <!-- TITLE                                               -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:gravity="center"

                android:text="Confirm payment recipient"

                android:textColor="@color/text_primary"

                android:textSize="22sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:gravity="center"

                android:text="Please verify the recipient before continuing."

                android:textColor="@color/text_secondary"

                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- RECIPIENT CARD                                      -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:orientation="vertical"

                android:gravity="center"

                android:padding="24dp"

                android:background="@drawable/bg_qr_recipient_card">


                <!-- AVATAR -->

                <TextView

                    android:id="@+id/tvRecipientInitials"

                    android:layout_width="72dp"
                    android:layout_height="72dp"

                    android:gravity="center"

                    android:text="RV"

                    android:textColor="@color/primary"

                    android:textSize="24sp"

                    android:textStyle="bold"

                    android:background="@drawable/bg_qr_recipient_avatar" />


                <!-- NAME -->

                <TextView

                    android:id="@+id/tvRecipientName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:gravity="center"

                    android:text="Recipient Name"

                    android:textColor="@color/text_primary"

                    android:textSize="20sp"

                    android:textStyle="bold" />


                <!-- VERIFIED -->

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:text="MyBank recipient"

                    android:textColor="@color/success"

                    android:textSize="13sp"

                    android:textStyle="bold" />


                <!-- ACCOUNT -->

                <TextView

                    android:id="@+id/tvMaskedAccount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:gravity="center"

                    android:text="XXXXXXXX0003"

                    android:textColor="@color/text_secondary"

                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PAYMENT ID CARD                                     -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="vertical"

                android:padding="16dp"

                android:background="@drawable/bg_qr_payment_id">


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Payment ID"

                    android:textColor="@color/text_secondary"

                    android:textSize="12sp" />


                <TextView

                    android:id="@+id/tvPaymentId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:text="PAY_..."

                    android:textColor="@color/primary"

                    android:textSize="13sp"

                    android:textStyle="bold"

                    android:breakStrategy="balanced" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SECURITY INFORMATION                                -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="vertical"

                android:padding="16dp"

                android:background="@drawable/bg_qr_info">


                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Security check"

                    android:textColor="@color/text_primary"

                    android:textSize="14sp"

                    android:textStyle="bold" />


                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:text="Only continue if the recipient details are correct."

                    android:textColor="@color/text_secondary"

                    android:textSize="13sp" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM BUTTON                                          -->
    <!-- ===================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:padding="16dp"

        android:background="@color/surface">


        <Button

            android:id="@+id/btnContinue"

            android:layout_width="match_parent"
            android:layout_height="54dp"

            android:text="Continue"

            android:textAllCaps="false"

            android:textColor="@android:color/white"

            android:textSize="16sp"

            android:textStyle="bold"

            android:backgroundTint="@color/primary" />

    </LinearLayout>

</LinearLayout>